+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { isDraftEmpty, parseDraft, serializeDraft, type CheckInDraft } from './checkinDraft';
+
+const base: CheckInDraft = {
+  day: '2026-09-29',
+  status: 'completed',
+  observations: '',
+  photo_uris: [],
+  skip_reason: null,
+  anomaly_types: [],
+  anomaly_products: {},
+  last_restock_date: null,
+  restock_products: [],
+  supervisor_id: null,
+  competition: null,
+};
+
+test('isDraftEmpty: el estado inicial está vacío', () => {
+  assert.equal(isDraftEmpty(base), true);
+});
+
+test('isDraftEmpty: una foto, un texto o un estado distinto lo ensucian', () => {
+  assert.equal(isDraftEmpty({ ...base, photo_uris: ['file:///a.jpg'] }), false);
+  assert.equal(isDraftEmpty({ ...base, observations: 'falta stock' }), false);
+  assert.equal(isDraftEmpty({ ...base, status: 'skipped' }), false);
+  assert.equal(isDraftEmpty({ ...base, observations: '   ' }), true);
+});
+
+test('parseDraft: ida y vuelta del mismo día', () => {
+  const d: CheckInDraft = { ...base, status: 'anomaly', anomaly_types: ['sin_stock'], anomaly_products: { sin_stock: ['p1'] } };
+  assert.deepEqual(parseDraft(serializeDraft(d), '2026-09-29'), d);
+});
+
+test('parseDraft: descarta el borrador de otro día', () => {
+  assert.equal(parseDraft(serializeDraft(base), '2026-09-30'), null);
+});
+
+test('parseDraft: null o corrupto devuelve null sin lanzar', () => {
+  assert.equal(parseDraft(null, '2026-09-29'), null);
+  assert.equal(parseDraft('{no es json', '2026-09-29'), null);
+  assert.equal(parseDraft(JSON.stringify({ ...base, status: 'raro' }), '2026-09-29'), null);
+});
