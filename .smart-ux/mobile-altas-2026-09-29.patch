--- /dev/null
+++ b/mobile/src/services/checkinDraft.ts
@@ -0,0 +1,85 @@
+import type { SQLiteDatabase } from 'expo-sqlite';
+import { getMeta, setMeta } from '../store/localStore';
+import type { AnomalyType, CompetitionReportRecord, StoreStatus, Visit } from '../types';
+
+/**
+ * Borrador del check-in de UNA tienda, persistido en `meta` (SQLite) para que
+ * un toque en atrás, un cierre de la app o un kill del sistema no tiren lo
+ * cargado. Las fotos se guardan como URIs locales: si el sistema las borró,
+ * la pantalla las descarta al restaurar.
+ */
+export interface CheckInDraft {
+  day: string;                       // YYYY-MM-DD local: un borrador de otro día no se restaura
+  status: StoreStatus;
+  observations: string;
+  photo_uris: string[];
+  skip_reason: Visit['skip_reason'];
+  anomaly_types: AnomalyType[];
+  anomaly_products: Record<string, string[]>;
+  last_restock_date: string | null;
+  restock_products: string[];
+  supervisor_id: string | null;
+  competition: CompetitionReportRecord | null;
+}
+
+/** Puro: true si el borrador no tiene nada que valga la pena guardar ni confirmar. */
+export function isDraftEmpty(d: Omit<CheckInDraft, 'day'>): boolean {
+  return (
+    d.status === 'completed' &&
+    d.observations.trim() === '' &&
+    d.photo_uris.length === 0 &&
+    d.skip_reason === null &&
+    d.anomaly_types.length === 0 &&
+    d.last_restock_date === null &&
+    d.restock_products.length === 0 &&
+    d.supervisor_id === null &&
+    d.competition === null
+  );
+}
+
+export function serializeDraft(d: CheckInDraft): string {
+  return JSON.stringify(d);
+}
+
+/** Puro: parsea el borrador; null si no existe, está corrupto o es de otro día (nunca lanza). */
+export function parseDraft(raw: string | null, today: string): CheckInDraft | null {
+  if (!raw) return null;
+  try {
+    const d = JSON.parse(raw) as Partial<CheckInDraft>;
+    if (!d || typeof d !== 'object' || d.day !== today) return null;
+    if (d.status !== 'completed' && d.status !== 'skipped' && d.status !== 'anomaly') return null;
+    return {
+      day: d.day,
+      status: d.status,
+      observations: typeof d.observations === 'string' ? d.observations : '',
+      photo_uris: Array.isArray(d.photo_uris) ? d.photo_uris.filter((u) => typeof u === 'string') : [],
+      skip_reason: d.skip_reason ?? null,
+      anomaly_types: Array.isArray(d.anomaly_types) ? d.anomaly_types : [],
+      anomaly_products: d.anomaly_products && typeof d.anomaly_products === 'object' ? d.anomaly_products : {},
+      last_restock_date: d.last_restock_date ?? null,
+      restock_products: Array.isArray(d.restock_products) ? d.restock_products : [],
+      supervisor_id: d.supervisor_id ?? null,
+      competition: d.competition ?? null,
+    };
+  } catch {
+    return null;
+  }
+}
+
+const key = (userId: string, storeId: string) => `checkin_draft:${userId}:${storeId}`;
+
+export async function saveDraft(db: SQLiteDatabase, userId: string, storeId: string, d: CheckInDraft): Promise<void> {
+  if (isDraftEmpty(d)) {
+    await clearDraft(db, userId, storeId);
+    return;
+  }
+  await setMeta(db, key(userId, storeId), serializeDraft(d));
+}
+
+export async function loadDraft(db: SQLiteDatabase, userId: string, storeId: string, today: string): Promise<CheckInDraft | null> {
+  return parseDraft(await getMeta(db, key(userId, storeId)), today);
+}
+
+export async function clearDraft(db: SQLiteDatabase, userId: string, storeId: string): Promise<void> {
+  await db.runAsync(`DELETE FROM meta WHERE key = ?`, key(userId, storeId));
+}
